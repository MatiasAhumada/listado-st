generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkshopStatus {
  ACTIVE
  SUSPENDED
}

enum TechnicianStatus {
  ACTIVE
  SUSPENDED
}

enum TechnicianRole {
  OWNER
  MEMBER
}

enum PlanCode {
  SOLO_TECHNICIAN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PlatformAuditAction {
  WORKSHOP_CREATED
  WORKSHOP_ACTIVATED
  WORKSHOP_SUSPENDED
}

model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions         PlatformAdminSession[]
  auditEvents      PlatformAuditEvent[]
  createdWorkshops Workshop[]             @relation("WorkshopCreator")

  @@map("platform_admins")
}

model PlatformAdminSession {
  id        String    @id @default(uuid())
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  adminId String
  admin   PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
  @@map("platform_admin_sessions")
}

model Workshop {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  status    WorkshopStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  createdByAdminId String
  createdByAdmin   PlatformAdmin @relation("WorkshopCreator", fields: [createdByAdminId], references: [id])

  technicians  TechnicianUser[]
  subscription WorkshopSubscription?
  auditEvents  PlatformAuditEvent[]

  @@index([status])
  @@map("workshops")
}

model TechnicianUser {
  id           String           @id @default(uuid())
  workshopId   String
  email        String           @unique
  passwordHash String
  displayName  String
  role         TechnicianRole   @default(OWNER)
  status       TechnicianStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId, status])
  @@map("technician_users")
}

model WorkshopSubscription {
  id        String             @id @default(uuid())
  planCode  PlanCode           @default(SOLO_TECHNICIAN)
  status    SubscriptionStatus @default(TRIAL)
  startedAt DateTime           @default(now())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  workshopId String   @unique
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("workshop_subscriptions")
}

model PlatformAuditEvent {
  id        String              @id @default(uuid())
  action    PlatformAuditAction
  metadata  Json?
  createdAt DateTime            @default(now())

  adminId String
  admin   PlatformAdmin @relation(fields: [adminId], references: [id])

  workshopId String?
  workshop   Workshop? @relation(fields: [workshopId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([workshopId, createdAt])
  @@map("platform_audit_events")
}
