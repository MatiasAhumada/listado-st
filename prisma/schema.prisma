generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkshopStatus {
  ACTIVE
  SUSPENDED
}

enum TechnicianStatus {
  ACTIVE
  SUSPENDED
}

enum PlanCode {
  SOLO_TECHNICIAN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PlatformAuditAction {
  WORKSHOP_CREATED
  WORKSHOP_ACTIVATED
  WORKSHOP_SUSPENDED
  CATALOG_IMPORTED
  CATALOG_PUBLISHED
  CATALOG_PRICING_UPDATED
}

enum CatalogImportStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions         PlatformAdminSession[]
  auditEvents      PlatformAuditEvent[]
  createdWorkshops Workshop[]             @relation("WorkshopCreator")
  catalogImports   CatalogImportBatch[]   @relation("CatalogImportCreator")

  @@map("platform_admins")
}

model PlatformAdminSession {
  id        String    @id @default(uuid())
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  adminId String
  admin   PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
  @@map("platform_admin_sessions")
}

model Workshop {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  status    WorkshopStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  createdByAdminId String
  createdByAdmin   PlatformAdmin @relation("WorkshopCreator", fields: [createdByAdminId], references: [id])

  technicians  TechnicianUser[]
  subscription WorkshopSubscription?
  auditEvents  PlatformAuditEvent[]

  @@index([status])
  @@map("workshops")
}

model TechnicianUser {
  id           String           @id @default(uuid())
  workshopId   String
  email        String           @unique
  passwordHash String
  displayName  String
  status       TechnicianStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workshop Workshop            @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  sessions TechnicianSession[]

  @@index([workshopId, status])
  @@map("technician_users")
}

model TechnicianSession {
  id        String    @id @default(uuid())
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  technicianId String
  technician   TechnicianUser @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId, expiresAt])
  @@map("technician_sessions")
}

model WorkshopSubscription {
  id        String             @id @default(uuid())
  planCode  PlanCode           @default(SOLO_TECHNICIAN)
  status    SubscriptionStatus @default(TRIAL)
  startedAt DateTime           @default(now())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  workshopId String   @unique
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("workshop_subscriptions")
}

model CatalogPricingRule {
  id               String   @id @default(uuid())
  position         Int      @unique
  maximumCost      Decimal? @db.Decimal(12, 2)
  markupPercentage Decimal  @db.Decimal(7, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("catalog_pricing_rules")
}

model CatalogImportBatch {
  id                  String              @id @default(uuid())
  fileName            String
  fileHash            String              @db.VarChar(64)
  status              CatalogImportStatus @default(DRAFT)
  totalRows           Int
  availableItems      Int
  excludedUnavailable Int
  excludedIncoming    Int
  skippedRows         Int
  importedAt          DateTime            @default(now())
  publishedAt         DateTime?

  importedByAdminId String
  importedByAdmin   PlatformAdmin @relation("CatalogImportCreator", fields: [importedByAdminId], references: [id])

  items CatalogItem[]

  @@index([status, importedAt])
  @@index([fileHash])
  @@map("catalog_import_batches")
}

model CatalogItem {
  id             String   @id @default(uuid())
  sourceRow      Int
  name           String
  normalizedName String
  brand          String?
  cost           Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  batchId String
  batch   CatalogImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, sourceRow])
  @@index([batchId, normalizedName])
  @@index([batchId, brand])
  @@map("catalog_items")
}

model PlatformAuditEvent {
  id        String              @id @default(uuid())
  action    PlatformAuditAction
  metadata  Json?
  createdAt DateTime            @default(now())

  adminId String
  admin   PlatformAdmin @relation(fields: [adminId], references: [id])

  workshopId String?
  workshop   Workshop? @relation(fields: [workshopId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([workshopId, createdAt])
  @@map("platform_audit_events")
}
